; Generated by installer/gen_iss.py - edit the generator, not this file.
; ModelCraft 0.4.0 - Windows installer (Inno Setup 6). Per-user by default (no admin rights);
; the extension list comes from ASSOC_EXTS in crates/swcraft/src/platform.rs.

#define AppName "ModelCraft"
#define AppVersion "0.4.0"
#define AppExe "modelcraft.exe"
#define ProgId "ModelCraft.Model"

[Setup]
AppId={{6F1C2B7E-4D5A-4E3B-9A1C-7D2E8B5F0A41}
AppName={#AppName}
AppVersion={#AppVersion}
AppVerName={#AppName} {#AppVersion}
AppPublisher=ModelCraft (independent project)
DefaultDirName={autopf}\{#AppName}
DefaultGroupName={#AppName}
DisableProgramGroupPage=yes
PrivilegesRequired=lowest
PrivilegesRequiredOverridesAllowed=dialog
ArchitecturesAllowed=x64compatible
ArchitecturesInstallIn64BitMode=x64compatible
ChangesAssociations=yes
OutputDir=..\dist
OutputBaseFilename=ModelCraft-Setup-{#AppVersion}
SetupIconFile=..\crates\swcraft\assets\modelcraft.ico
UninstallDisplayIcon={app}\{#AppExe}
Compression=lzma2/max
SolidCompression=yes
WizardStyle=modern

[Languages]
Name: "fr"; MessagesFile: "compiler:Languages\French.isl"
Name: "en"; MessagesFile: "compiler:Default.isl"

[CustomMessages]
fr.Assoc=Ouvrir ces types de fichiers avec ModelCraft :
en.Assoc=Open these file types with ModelCraft:
fr.Desktop=Créer une icône sur le Bureau
en.Desktop=Create a desktop icon
fr.Scanner=Scanner de dossiers (lecture seule)
en.Scanner=Folder scanner (read-only)
fr.Launch=Lancer ModelCraft
en.Launch=Launch ModelCraft

fr.ext_sldprt=.sldprt - Pièce SolidWorks
en.ext_sldprt=.sldprt - SolidWorks part
fr.ext_sldasm=.sldasm - Assemblage SolidWorks
en.ext_sldasm=.sldasm - SolidWorks assembly
fr.ext_step=.step - STEP
en.ext_step=.step - STEP
fr.ext_stp=.stp - STEP
en.ext_stp=.stp - STEP
fr.ext_iges=.iges - IGES
en.ext_iges=.iges - IGES
fr.ext_igs=.igs - IGES
en.ext_igs=.igs - IGES
fr.ext_stl=.stl - Maillage STL
en.ext_stl=.stl - STL mesh
fr.ext_obj=.obj - Wavefront OBJ
en.ext_obj=.obj - Wavefront OBJ
fr.ext_3ds=.3ds - 3D Studio
en.ext_3ds=.3ds - 3D Studio
fr.ext_3dxml=.3dxml - 3D XML
en.ext_3dxml=.3dxml - 3D XML
fr.ext_easm=.easm - eDrawings assemblage
en.ext_easm=.easm - eDrawings assembly
fr.ext_rvt=.rvt - Projet Revit (vignette, infos)
en.ext_rvt=.rvt - Revit project (preview, info)
fr.ext_rfa=.rfa - Famille Revit (vignette, infos)
en.ext_rfa=.rfa - Revit family (preview, info)
fr.ext_ifc=.ifc - IFC (BIM)
en.ext_ifc=.ifc - IFC (BIM)
fr.ext_ifczip=.ifczip - IFC compressé
en.ext_ifczip=.ifczip - Zipped IFC
fr.ext_fbx=.fbx - FBX
en.ext_fbx=.fbx - FBX
fr.ext_gltf=.gltf - glTF
en.ext_gltf=.gltf - glTF
fr.ext_glb=.glb - glTF binaire
en.ext_glb=.glb - Binary glTF
fr.ext_dae=.dae - COLLADA
en.ext_dae=.dae - COLLADA
fr.ext_3mf=.3mf - 3MF
en.ext_3mf=.3mf - 3MF
fr.ext_ply=.ply - PLY
en.ext_ply=.ply - PLY
fr.ext_off=.off - OFF
en.ext_off=.off - OFF
fr.ext_amf=.amf - AMF
en.ext_amf=.amf - AMF
fr.ext_wrl=.wrl - VRML
en.ext_wrl=.wrl - VRML
fr.ext_x3d=.x3d - X3D
en.ext_x3d=.x3d - X3D
fr.ext_usdz=.usdz - USDZ
en.ext_usdz=.usdz - USDZ
fr.ext_dxf=.dxf - DXF (3D)
en.ext_dxf=.dxf - DXF (3D)

[Tasks]
Name: "desktop"; Description: "{cm:Desktop}"; Flags: unchecked
Name: "assoc"; Description: "{cm:Assoc}"

Name: "assoc\sldprt"; Description: "{cm:ext_sldprt}"
