1 ICON "modelcraft.ico"
1 VERSIONINFO
FILEVERSION @V4@
PRODUCTVERSION @V4@
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040C04B0"
    BEGIN
      VALUE "FileDescription", "ModelCraft - visionneuse 3D"
      VALUE "ProductName", "ModelCraft"
      VALUE "FileVersion", "@V@"
      VALUE "ProductVersion", "@V@"
      VALUE "LegalCopyright", "MIT"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x040C, 1200
  END
END
